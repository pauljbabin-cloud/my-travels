// use prisma-8

model Trip {
  id                String       @id @default(uuid())
  actionKey         String       @unique // e.g., "Ontario", "StoNF", "Newfoundland"
  panLat            Float
  panLng            Float
  zoom              Int
  htmlDescription   String       // Stores the rich HTML text shown in the sidebar
  waypoints         Waypoint[]
  details           TripDetail[]
  createdAt         TimestamptzString @default(now())
}

model Waypoint {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type      String   // "origin", "destination", or "intermediate"
  lat       Float
  lng       Float
  name      String?  // Optional site name from the CSV
  routeNum  Int      @default(0) // Distinguishes route0 from route1 if a trip has multiple route CSVs
  order     Int      // To ensure the path points are loaded sequentially
}

model TripDetail {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  title       String
  description String
  image       String   // Will store "blank" or the slideshow image ID
  type        String   // e.g., "faCamera", "faBed"
  order       Int      // Maintains sidebar ordering sequence
}

model Home {
  id          Int      @id @default(autoincrement())
  lat         Float
  lng         Float
  address     String
  from        String
  to          String
  description String
  type        String   // e.g., "faHouseUser", "faHospitalUser"
}
