// use prisma-8

model Trip {
  id                String       @id @onCreate(uuid())
  actionKey         String       @unique // e.g., "Ontario", "StoNF", "Newfoundland"
  panLat            Float
  panLng            Float
  zoom              Int
  htmlDescription   String       
  waypoints         Waypoint[]
  details           TripDetail[]
  createdAt         TimestamptzString @default(now())
}

model Waypoint {
  id        String   @id @onCreate(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type      String   
  lat       Float
  lng       Float
  name      String?  
  routeNum  Int      @default(0) // Distinguishes route0 from route1 if a trip has multiple route CSVs
  order     Int      
}

model TripDetail {
  id          String   @id @onCreate(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  title       String
  description String
  image       String  
  type        String  
  order       Int     
}

model Home {
  id          Int      @id @default(autoincrement())
  lat         Float
  lng         Float
  address     String
  from        String
  to          String
  description String
  type        String  
}

model Places {
  id          Int      @id @default(autoincrement())
  lat         Float
  lng         Float
  title       String
  image       String  
  type        String  
}
