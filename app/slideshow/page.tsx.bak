'use client';

import React, { useState, useEffect, Suspense } from 'react';
import { useSearchParams } from 'next/navigation';

interface Props {}

const SlideshowComponent: React.FC<Props> = () => {
    const searchParams = useSearchParams();
    const showId = searchParams.get('showId');

    const [images, setImages] = useState<string[]>([]);
    const [slideIndex, setSlideIndex] = useState<number>(0);
    const [loading, setLoading] = useState<boolean>(true);

    useEffect(() => {
        if (!showId || showId === 'blank') {
            setLoading(false);
            return;
        }

        fetch(`/api/get-images?showId=${encodeURIComponent(showId)}`)
            .then((response) => response.json())
            .then((data) => {
                if (data.error) {
                    console.error("API Error:", data.error);
                } else if (data.length === 0) {
                    console.warn("No images found in this folder.");
                } else {
                    setImages(data);
                }
                setLoading(false);
            })
            .catch((error) => {
                console.error("Error fetching images:", error);
                setLoading(false);
            });
    }, [showId]);

    const nextSlide = () => {
        if (images.length === 0) return;
        setSlideIndex((prevIndex) => (prevIndex + 1) % images.length);
    };

    const prevSlide = () => {
        if (images.length === 0) return;
        setSlideIndex((prevIndex) => (prevIndex - 1 + images.length) % images.length);
    };

    const getFilename = (url: string) => {
        const match = url.match(/[^/]+(?=\.[^.]+$)/);
        return match ? match[0] : 'Image';
    };

    if (loading) {
        return <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '100vh', fontFamily: 'Arial, sans-serif' }}>Loading...</div>;
    }

    return (
        <>
            <style jsx global>{`
                * {
                    box-sizing: border-box;
                    margin: 0;
                    padding: 0;
                }
                body {
                    font-family: Arial, sans-serif;
                    background-color: #f4f4f4;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    height: 100vh;
                }
                .slideshow-container {
                    max-width: 800px;
                    width: 100%;
                    position: relative;
                    margin: auto;
                    overflow: hidden;
                    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
                    border-radius: 8px;
                    background-color: #000;
                    height: 500px; /* Adjust layout constraints safely */
                    display: flex;
                    justify-content: center;
                    align-items: center;
                }
                .mySlides {
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    box-sizing: border-box; 
                    width: 100%;
                    height: 100%;
                }
                .mySlides img {
                    max-width: 100vw;
                    max-height: 100vh;
                    width: auto;
                    height: auto;
                    object-fit: contain;
                }
                .prev, .next {
                    cursor: pointer;
                    position: absolute;
                    top: 50%;
                    transform: translateY(-50%);
                    padding: 16px;
                    color: white;
                    font-weight: bold;
                    font-size: 18px;
                    background-color: rgba(0, 0, 0, 0.4);
                    border: none;
                    border-radius: 0 3px 3px 0;
                    user-select: none;
                    transition: background-color 0.3s ease;
                    z-index: 10;
                }
				.prev {
					left: 0;
					border-radius: 3px 0 0 3px;
				}
                .next {
                    right: 0;
                    border-radius: 3px 0 0 3px;
                }
                .prev:hover, .next:hover {
                    background-color: rgba(0, 0, 0, 0.8);
                }
                .caption {
                    color: #f2f2f2;
                    font-size: 15px;
                    padding: 12px 24px;
                    position: absolute;
                    bottom: 15px;
                    width: 100%;
                    text-align: center;
                    background-color: rgba(0,0,0,0.5);
                }
                .fade {
                    animation-name: fadeAnimation;
                    animation-duration: 0.8s;
                }
                @keyframes fadeAnimation {
                    from { opacity: 0.4; } 
                    to { opacity: 1; }
                }
            `}</style>

            <div className="slideshow-container">
                {images.length > 0 && (
                    <div className="mySlides fade">
                        <img 
                            src={images[slideIndex]} 
                            alt={getFilename(images[slideIndex])} 
                        />
                        <div className="caption">{getFilename(images[slideIndex])}</div>
                    </div>
                )}

                {images.length === 0 && !loading && (
                    <div style={{ color: '#fff', textAlign: 'center', padding: '20px' }}>
                        No slideshow content to display.
                    </div>
                )}

                <button className="prev" id="prevBtn" onClick={prevSlide}>❮</button>
                <button className="next" id="nextBtn" onClick={nextSlide}>❯</button>
            </div>
        </>
    );
};

const Component = () => {
    return (
        <Suspense fallback={<div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '100vh', fontFamily: 'Arial, sans-serif' }}>Loading layout...</div>}>
            <SlideshowComponent />
        </Suspense>
    );
};

export default Component;
